# Copy to .env.local for local dev. In production, set these in Vercel
# (Project Settings -> Environment Variables), never commit real values.

# Neon Postgres connection string. Get it from the Vercel dashboard after
# adding the "Neon" integration (Storage tab -> Browse Marketplace -> Neon),
# or directly from https://console.neon.tech if you create a project there.
DATABASE_URL=

# YouTube Data API v3 key. Steps:
# 1. https://console.cloud.google.com/ -> create (or pick) a project
# 2. APIs & Services -> Library -> enable "YouTube Data API v3"
# 3. APIs & Services -> Credentials -> Create Credentials -> API key
# 4. Recommended: click "Restrict key" -> API restrictions -> limit to
#    "YouTube Data API v3" only, so a leaked key can't be reused elsewhere.
YOUTUBE_API_KEY=

# Anthropic API key, for the real sentiment/topic/narrative analysis.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Overrides the Claude model used for content/brief analysis
# (src/lib/analysis/). Defaults to "claude-sonnet-5" if unset.
ANTHROPIC_MODEL=

# Shared password for the site-wide login gate (see src/middleware.ts).
# Pick any string; share it out-of-band with people you send the link to.
SITE_PASSWORD=

# Optional, not required to run the app. When set, the corresponding
# platform's "Connect" card on /channels activates with a real fetch instead
# of showing as inactive. Left unset in this prototype (see PROJECT_BRIEF.md
# for why X/Instagram/Facebook live ingestion isn't included by default).
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
